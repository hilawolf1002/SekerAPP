{
  "name": "surveypro",
  "version": "1.0.0",
  "description": "מערכת סקרים מתקדמת עם עיצוב רספונסיבי ו-UX/UI מוקפד",
  "main": "server.js",
  "scripts": {
    "start": "node server.js",
    "dev": "nodemon server.js",
    "pm2:start": "pm2 start ecosystem.config.js --env production",
    "pm2:stop": "pm2 stop surveypro",
    "pm2:restart": "pm2 restart surveypro",
    "pm2:delete": "pm2 delete surveypro",
    "pm2:logs": "pm2 logs surveypro",
    "pm2:monit": "pm2 monit",
    "pm2:reload": "pm2 reload surveypro",
    "deploy": "bash deploy.sh",
    "health": "node health-check.js",
    "test": "echo \"Error: no test specified\" && exit 1"
  },
  "keywords": [
    "survey",
    "polls",
    "hebrew",
    "responsive",
    "modern-ui",
    "express",
    "nodejs"
  ],
  "author": "SurveyPro Team",
  "license": "MIT",
  "dependencies": {
    "@google-cloud/bigquery": "^7.9.4",
    "axios": "^1.11.0",
    "bcrypt": "^5.1.1",
    "better-sqlite3": "^9.4.3",
    "compression": "^1.7.4",
    "cors": "^2.8.5",
    "dotenv": "^17.2.1",
    "express": "^4.18.2",
    "express-rate-limit": "^7.1.5",
    "express-session": "^1.18.2",
    "helmet": "^7.1.0",
    "jsonwebtoken": "^9.0.2",
    "multer": "^2.0.2",
    "passport": "^0.7.0",
    "passport-google-oauth20": "^2.0.0",
    "session-file-store": "^1.5.0"
  },
  "devDependencies": {
    "nodemon": "^3.0.2"
  },
  "engines": {
    "node": ">=16.0.0",
    "npm": ">=8.0.0"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/surveypro/surveypro.git"
  },
  "bugs": {
    "url": "https://github.com/surveypro/surveypro/issues"
  },
  "homepage": "https://github.com/surveypro/surveypro#readme"
}
