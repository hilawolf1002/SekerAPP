{
  "name": "sekerapp-root",
  "version": "1.0.0",
  "private": true,
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "install:all": "npm install --prefix server && npm install --prefix client",
    "db:up": "docker compose up -d db",
    "db:down": "docker compose down",
    "db:migrate": "npm run db:migrate --prefix server",
    "db:studio": "npm run db:studio --prefix server",
    "dev:server": "npm run dev --prefix server",
    "dev:client": "npm run dev --prefix client",
    "dev": "concurrently \"npm run dev:server\" \"npm run dev:client\"",
    "build": "npm run build --prefix client && npm run build --prefix server",
    "start": "npm run start:prod --prefix server",
    "railway:build": "npm install --prefix server --include=dev && npm install --prefix client && npm run build",
    "railway:start": "npm run start:prod --prefix server"
  },
  "devDependencies": {
    "concurrently": "^8.2.2"
  }
}
