# העתיקי לקובץ .env והשלימי ערכים אמיתיים. אל תעלי .env ל-Git.

DATABASE_URL="postgresql://postgres:password@localhost:5432/sekerapp?schema=public"

PORT=5000
NODE_ENV=development

JWT_SECRET="change-me-to-a-long-random-secret"
JWT_EXPIRES_IN="7d"
CORS_ORIGINS="http://localhost:3000"

OTP_TTL_MINUTES=5
OTP_MAX_ATTEMPTS=5
OTP_REQUEST_WINDOW_MINUTES=15
OTP_MAX_REQUESTS_PER_PHONE=5
OTP_RESEND_COOLDOWN_SECONDS=60
# sms = שליחה אמיתית ב-SMS | console = הדפסה ללוג השרת (בלי SMS)
OTP_DELIVERY=sms

# אופציונלי ורק לפיתוח (NODE_ENV!=production) – השאירי ריק כדי לבטל
DEV_AUTH_BYPASS_PHONE=0548457502

# סיסמת אדמין לצורך פיתוח (בפרודקשן צריך סיסמה חזקה)
ADMIN_PASSWORD=1234admin

# ספק SMS – Mesergo (Inforu)
MESERGO_USERNAME=
MESERGO_TOKEN=
MESERGO_SENDER=SekerApp

# כתובת ציבורית לקישורים ב-SMS (הזמנות / referral)
PUBLIC_BASE_URL=http://localhost:3000

# מייל אדמין לקבלת פניות פדיון (ריק = הדפסה ללוג)
ADMIN_EMAIL=

# SMTP לשליחת מיילים (ריק = הדפסה ללוג)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
